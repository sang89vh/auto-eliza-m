# Settings for the root song-display app (server.js). server.js reads these from the
# environment: copy this file to .env and start it with `node --env-file=.env server.js`
# (Node 20.6+), or export the variables yourself. Never commit .env.

# Merge script run by POST /api/create-video. On Windows, server.js runs it through
# cmd.exe, so use a native Windows path to the .bat, e.g. C:\path\to\auto-eliza-m\shscript\merge_audio_video.bat
SCRIPT_PATH=./shscript/merge_audio_video.sh

# SQLite songs database (create one with `node setup-db.js ./data/songs_win.db`)
DATA_BASE_PATH=./data/songs_win.db

# Folders used by POST /api/find_and_copy (defaults: ~/backupwav and ~/suno/input)
BACKUP_WAV_DIR=
DOWNLOAD_DIR=
