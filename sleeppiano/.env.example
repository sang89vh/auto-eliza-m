# ---- SleepPiano Pipeline configuration ----
# Copy this file to .env and fill in your own values. Never commit .env.
# Relative paths resolve against this folder (sleeppiano/); a leading ~ is your home folder.
PORT=3999

# Asset A: the songs DB. It needs a my_song table (see the root README for how to
# create one); the sleeppiano migration adds the piano_* columns on first run.
DB_PATH=../data/songs_win.db

# Asset B: your OpenAI API key. dotenv never overwrites a variable that is already in
# the environment, so an exported OPENAI_API_KEY wins over this line.
OPENAI_API_KEY=
# Any chat model your key can use; pre-flight checks that the model exists.
OPENAI_MODEL=gpt-5.6-luna

# Asset E: Suno downloads and finished videos.
# Windows example: DOWNLOAD_DIR=D:\suno\input
DOWNLOAD_DIR=~/suno/input
OUTPUT_DIR=~/suno/output

# Assets F/G: Playwright persistent profiles (created by `npm run setup:login`). They
# hold your signed-in Suno and YouTube sessions, so they are git-ignored -- keep them private.
SUNO_PROFILE_DIR=./profiles/suno
YT_PROFILE_DIR=./profiles/youtube

# Asset C: the converter is the Mjudio app (free on the Mac App Store and Microsoft
# Store). It exposes a loopback REST automation API whose port and token are published
# in endpoint.json, so there is no fixed API URL to configure -- only the discovery file
# location. Leave this empty to use the platform default:
#   macOS:   ~/Library/Containers/com.mjudio.musicvideomaker/Data/Library/Application Support/Mjudio/Automation/endpoint.json
#   Windows: %APPDATA%\Mjudio\Automation\endpoint.json
MVM_ENDPOINT_FILE=
MVM_TEMPLATE_ID=
MVM_RESOLUTION=1080p
MVM_CODEC=h264
MVM_FRAME_RATE=30

# Where Step 3 downloads the audio from. `studio` (default) opens each finished clip in
# Suno Studio and downloads it from the timeline -- exempt from the monthly library
# download cap Suno introduced on 2026-09-03 (Free 7 total, Pro 20, Premier 60) but
# it needs the Premier plan and adds ~45 s per clip. `library` is the old per-row
# Download menu on the create page, which spends that cap.
SUNO_DOWNLOAD_VIA=studio

DAILY_TARGET_MINUTES=120
MAX_SONGS_PER_RUN=50
HEADLESS=false
VISIBILITY=unlisted
TITLE_TEMPLATE={theme} | Relaxing Piano Sleep Music
DESCRIPTION_INTRO=Soft instrumental piano to help you fall asleep. 🎹
DESCRIPTION_INCLUDE_INTRODUCTIONS=false
ALTERED_CONTENT_DISCLOSURE=no
YOUTUBE_TAGS=piano sleep music, relaxing piano, deep sleep, calm piano
BACKGROUND_IMAGE_PATH=./assets/background.jpg
USE_PROMPT2_WHEN_SHORT=true
RETRY_ERRORS=false

# Operational thresholds
MIN_FREE_GB=20
LOUDNORM_TARGET_LUFS=-14
TRACK_MIN_SECONDS=90
TRACK_MAX_SECONDS=360
CROSSFADE_SECONDS=0

# setup:login only — minutes to wait for a manual sign-in before assuming it is done
LOGIN_WAIT_MINUTES=5
