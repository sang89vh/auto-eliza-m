{
  "name": "sleeppiano",
  "version": "1.0.0",
  "private": true,
  "description": "One-click daily generation of a 2-hour piano sleep music video (SQLite -> OpenAI -> Suno -> Video -> YouTube)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "setup:login": "tsx src/setup/login.ts",
    "migrate": "tsx src/setup/migrate.ts",
    "typecheck": "tsc --noEmit",
    "run:daily": "tsx src/setup/run_daily.ts",
    "prepare:daily": "tsx src/setup/run_daily.ts --prepare-only"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.85.0",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
