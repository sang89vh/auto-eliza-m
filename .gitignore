# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Secrets and personal data -- keep these out of the repository.
# .env holds API keys and local paths (copy .env.example instead); the songs
# databases, browser profiles and logs are per-user working state.
.env
*.iml
data/*.db
data/*.sqbpro
profiles/
logs/
macro/
*.sqbpro
*.bplist
# ytmusicapi credentials, if pyscript/ is ever run signed in
oauth.json
browser.json
headers_auth.json
# Generated audio
*.wav
*.mp3
# Commercial fonts (e.g. Arial) may not be redistributed; use the system copy.
shscript/*.ttf

# SleepPiano pipeline
# SleepPiano opens the songs DB in WAL mode so long pipeline writes do not block
# the existing server.js reader; these are SQLite's sidecar files.
data/*.db-wal
data/*.db-shm
data/backup/
sleeppiano/.env
sleeppiano/node_modules/
sleeppiano/profiles/
sleeppiano/assets/background.jpg
sleeppiano/logs/

# VietCafe pipeline (cafe-with-vocals sibling of SleepPiano; the WAL sidecar
# patterns above cover its DB too)
data/songs_vietcafe.db
vietcafe/.env
vietcafe/node_modules/
vietcafe/profiles/
vietcafe/assets/background.jpg
vietcafe/logs/
