# Use Node.js LTS version
FROM node:18-alpine

# Install ffmpeg and other required dependencies
RUN apk add --no-cache \
    ffmpeg \
    bash

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application
COPY . .

# Create necessary directories
RUN mkdir -p /app/data /app/input /app/seed /app/output /app/outputprocessed /app/processed

# Mount volumes for all required directories
VOLUME ["/app/data", "/app/input", "/app/seed", "/app/output", "/app/outputprocessed", "/app/processed"]

# Expose backend port
EXPOSE 3001

# Start the backend server
CMD ["npm", "run", "server"] 